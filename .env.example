# Copia este fichero a .env.local (desarrollo) o define las variables en Dokploy.

# Ruta del fichero SQLite. En Docker apunta al volumen persistente /data.
DATABASE_PATH=./data/app.db

# Carpeta donde se guardan las fotos de las recetas (también en el volumen).
UPLOADS_DIR=./data/uploads

# Código de acceso opcional. Si se define, la app lo pide una vez y lo recuerda
# en una cookie durante un año. Muy recomendable si la URL es pública.
ACCESS_CODE=

# Clave de la API de Anthropic (console.anthropic.com) para importar y generar recetas.
ANTHROPIC_API_KEY=

# Modelo de IA (opcional). Por defecto claude-opus-5-5, el más capaz.
# Para abaratar costes puedes usar claude-sonnet-5-5 o claude-haiku-5-5.
ANTHROPIC_MODEL=

# Zona horaria para "hoy" y las semanas del menú (opcional).
APP_TIMEZONE=Europe/Madrid
